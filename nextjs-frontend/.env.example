# Backend API base URL (Railway 내부 통신: http://fastapi-backend.railway.internal:8000)
API_BASE_URL=http://localhost:8000

# OpenAPI generated file name (relative to the frontend directory)
OPENAPI_OUTPUT_FILE=openapi.json

# ── drksample1 추가 환경 변수 ────────────────────────────────────────────
# FastAPI 서버 URL (Next.js Server Components에서 사용)
FASTAPI_URL=http://localhost:8000

# 앱 공개 URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── drksample1 인증 환경 변수 ────────────────────────────────────────────
# FastAPI 서버 URL (Server Action 전용 — NEXT_PUBLIC_ 접두사 없음)
API_URL=http://localhost:8000

# JWT 서명 키 (백엔드 SECRET_KEY와 동일한 값)
SECRET_KEY=your-secret-key-here